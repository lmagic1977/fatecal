# Optional: turns on FateBot's AI answers. Without it FateBot falls back to rule-based replies.
ANTHROPIC_API_KEY=
# Optional: model id, defaults to claude-haiku-5-5
FATECAL_MODEL=

# Optional: Meta (Facebook) ads tracking. The Pixel ID is a public identifier.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional: Meta domain-verification code for fatecal.com (Business Settings > Brand safety > Domains).
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=
